    { "op": "pose", "joints": { "thigh_l": -90, "thigh_r": -90, "shin_l": 0, "shin_r": 0, "spine": -25, "arm_u_l": 40, "arm_u_r": -40 }, "ticks": 5 },
    { "op": "emit", "event": "lying_down" }
  ] }
}
