{
  "id": "crouch", "kind": "gesture",
  "tags": ["crouch","crouching","duck","low","hide","avoid","stealth"],
  "desc": "Drop into a low crouch with bent knees and forward lean, then stand.",
  "variant": { "time": [0.9, 1.1], "amplitude": [0.9, 1.0] },
  "root": { "op": "sequence", "children": [
    { "op": "balance", "on": false },
    { "op": "parallel", "children": [
      { "op": "pose", "joints": { "thigh_l": -80, "thigh_r": -80, "shin_l": 100, "shin_r": 100 }, "ticks": 4 },
      { "op": "pose", "joints": { "spine": -10, "head": -10 }, "ticks": 4 }
    ] },
    { "op": "wait", "ticks": 6 },
    { "op": "parallel", "children": [
      { "op": "pose", "joints": { "thigh_l": 0, "thigh_r": 0, "shin_l": 0, "shin_r": 0 }, "ticks": 4 },
      { "op": "pose", "joints": { "spine": 0, "head": 0 }, "ticks": 4 }
    ] },
    { "op": "balance", "on": true }
  ] }
}
