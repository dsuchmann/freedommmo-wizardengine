{
  "id": "lunge", "kind": "gesture",
  "tags": ["lunge","lunging","exercise","legs","stretch","step forward","strength"],
  "desc": "Step forward into a lunge — front knee bent, rear leg extended — then return to standing.",
  "variant": { "time": [0.9, 1.1], "amplitude": [0.9, 1.0] },
  "root": { "op": "sequence", "children": [
    { "op": "balance", "on": false },
    { "op": "parallel", "children": [
      { "op": "pose", "joints": { "thigh_l": -40, "shin_l": 60, "thigh_r": 20, "shin_r": 20 }, "ticks": 4 },
      { "op": "pose", "joints": { "spine": -10 }, "ticks": 4 }
    ] },
    { "op": "wait", "ticks": 4 },
    { "op": "parallel", "children": [
      { "op": "pose", "joints": { "thigh_l": 0, "shin_l": 0, "thigh_r": 0, "shin_r": 0 }, "ticks": 4 },
      { "op": "pose", "joints": { "spine": 0 }, "ticks": 4 }
    ] },
    { "op": "balance", "on": true }
  ] }
}
