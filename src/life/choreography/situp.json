{
  "id": "situp", "kind": "gesture",
  "tags": ["situp","sit up","exercise","core","abs","crunch","floor"],
  "desc": "Three sit-up repetitions from a lying position — curling the spine upward then back down.",
  "variant": { "time": [0.9, 1.1], "amplitude": [1, 1] },
  "root": { "op": "sequence", "children": [
    { "op": "balance", "on": false },
    { "op": "pose", "joints": { "thigh_l": -90, "thigh_r": -90, "shin_l": 90, "shin_r": 90, "spine": -20 }, "ticks": 5 },
    { "op": "pose", "joints": { "thigh_l": -90, "thigh_r": -90, "shin_l": 90, "shin_r": 90, "spine": 20 }, "ticks": 4 },
    { "op": "pose", "joints": { "thigh_l": -90, "thigh_r": -90, "shin_l": 90, "shin_r": 90, "spine": -20 }, "ticks": 4 },
    { "op": "pose", "joints": { "thigh_l": -90, "thigh_r": -90, "shin_l": 90, "shin_r": 90, "spine": 20 }, "ticks": 4 },
    { "op": "pose", "joints": { "thigh_l": -90, "thigh_r": -90, "shin_l": 90, "shin_r": 90, "spine": -20 }, "ticks": 4 },
    { "op": "pose", "joints": { "thigh_l": -90, "thigh_r": -90, "shin_l": 90, "shin_r": 90, "spine": 20 }, "ticks": 4 },
    { "op": "pose", "joints": { "thigh_l": 0, "thigh_r": 0, "shin_l": 0, "shin_r": 0, "spine": 0 }, "ticks": 6 },
    { "op": "balance", "on": true }
  ] }
}
