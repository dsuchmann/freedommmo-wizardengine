    ] },
    { "op": "parallel", "children": [
      { "op": "pose", "joints": { "arm_u_l": 0, "arm_u_r": 0, "thigh_l": 0, "thigh_r": 0 }, "ticks": 3 },
      { "op": "pose", "joints": { "head": 0 }, "ticks": 3 }
    ] },
    { "op": "parallel", "children": [
      { "op": "pose", "joints": { "arm_u_l": -90, "arm_u_r": 90, "thigh_l": -20, "thigh_r": -20 }, "ticks": 3 },
      { "op": "pose", "joints": { "head": 0 }, "ticks": 3 }
    ] },
    { "op": "parallel", "children": [
      { "op": "pose", "joints": { "arm_u_l": 0, "arm_u_r": 0, "thigh_l": 0, "thigh_r": 0 }, "ticks": 3 },
      { "op": "pose", "joints": { "head": 0 }, "ticks": 3 }
    ] },
    { "op": "parallel", "children": [
      { "op": "pose", "joints": { "arm_u_l": -90, "arm_u_r": 90, "thigh_l": -20, "thigh_r": -20 }, "ticks": 3 },
      { "op": "pose", "joints": { "head": 0 }, "ticks": 3 }
    ] },
    { "op": "parallel", "children": [
      { "op": "pose", "joints": { "arm_u_l": 0, "arm_u_r": 0, "thigh_l": 0, "thigh_r": 0 }, "ticks": 3 },
      { "op": "pose", "joints": { "head": 0 }, "ticks": 3 }
    ] }
  ] }
