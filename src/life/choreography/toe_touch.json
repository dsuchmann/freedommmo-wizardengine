{
  "id": "toe_touch", "kind": "gesture",
  "tags": ["toe touch","touch toes","bend","forward fold","hamstring","stretch","flexibility"],
  "desc": "Bend forward to touch the toes — arms reaching down — then stand back up.",
  "variant": { "time": [0.9, 1.1], "amplitude": [0.9, 1.0] },
  "root": { "op": "sequence", "children": [
    { "op": "balance", "on": false },
    { "op": "parallel", "children": [
      { "op": "pose", "joints": { "spine": 25, "arm_u_l": 30, "arm_u_r": -30, "head": -20 }, "ticks": 5 },
      { "op": "pose", "joints": { "thigh_l": 20, "thigh_r": 20 }, "ticks": 5 }
    ] },
    { "op": "wait", "ticks": 4 },
    { "op": "parallel", "children": [
      { "op": "pose", "joints": { "spine": 0, "arm_u_l": 0, "arm_u_r": 0, "head": 0 }, "ticks": 5 },
      { "op": "pose", "joints": { "thigh_l": 0, "thigh_r": 0 }, "ticks": 5 }
    ] },
    { "op": "balance", "on": true }
  ] }
}
